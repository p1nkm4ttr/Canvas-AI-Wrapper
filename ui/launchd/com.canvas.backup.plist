<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.canvas.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/agent/.venv/bin/canvas-backup</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__/agent</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>20</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/canvas-backup.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/canvas-backup.log</string>
</dict>
</plist>
